# Secrets & runtime-only data — keep out of the build context and image layers.
.env
.env.*
!.env.example
# Admin credential hash is written/read at runtime only; never bake it in.
data/admin.json
# User uploads are served from a bind-mount + R2 at runtime, not from the image.
public/uploads

# Runtime state must never be baked into the image (backups embed admin.json).
data/content.db
data/content.db-*
data/backups
data/mongo_config.json
data/contact-inbox.jsonl
data/*_snapshots
