# Secrets & runtime-only data — keep out of the build context and image layers.
.env
.env.*
!.env.example
# User uploads are served from a bind-mount + R2 at runtime, not from the image.
public/uploads

# data/ is the live runtime directory on the server (content.db, admin.json,
# the contact inbox and its state, backups, snapshots, crash-leftover *.tmp
# files, …), and the standalone tracer copies whatever is in it into the
# image. Allow-list the git seeds the build actually reads (lib/contentStore.ts
# seeds a missing kv row from data/<key>.json: home, cvdata) so any runtime
# file — including ones added later — stays out by default.
data/*
!data/home.json
!data/cvdata.json
