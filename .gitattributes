# Treat font + image binaries as binary so git's LF↔CRLF text normalization
# never corrupts them on Windows checkouts.
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.avif   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.mov    binary
