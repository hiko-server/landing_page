NODE_ENV=production

# ── Public branding ────────────────────────────────────────────────────────
NEXT_PUBLIC_PRODUCT_NAME=HIKO.DEV
NEXT_PUBLIC_SITE_HOST=hiko.dev

# ── Admin auth (used to bootstrap data/admin.json if missing) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change-this-to-strong-password
ADMIN_USER=admin@example.com

# ── JWT (REQUIRED — must be at least 32 chars of random entropy) ───────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32

# ── Site URL (used in password reset / email links) ────────────────────────
SITE_URL=https://hiko.dev
NOTIFY_EMAIL=hi@hiko.dev

# ── SMTP (optional)
#    lib/mailer.ts skips send if any of HOST / USER / PASS / FROM is unset
#    or blank, so dev can leave these empty and the contact form still
#    completes end-to-end (no mail leaves the box).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── Contact form human check (built-in, no external service) ──────────────
# v6 uses signed nonce + math captcha + honeypot instead of hCaptcha.
# No env required.

# ── GitHub API (raises unauthenticated 60/hr limit to 5000/hr) ───────────
GITHUB_TOKEN=REDACTED_GITHUB_PAT

# ── Feature flags ──────────────────────────────────────────────────────────
ENABLE_DEMO=false
