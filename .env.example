NODE_ENV=production

# ── Public branding ────────────────────────────────────────────────────────
NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_SITE_HOST=
# Theme for visitors who have not picked System / Light / Dark yet (build
# time): empty = dark (the brand look), or light / system.
NEXT_PUBLIC_DEFAULT_THEME=

# ── Admin auth (used to bootstrap data/admin.json if missing) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change-this-to-strong-password
ADMIN_USER=admin@example.com

# ── JWT (REQUIRED — must be at least 32 chars of random entropy) ───────────
# Generate with: openssl rand -base64 32
# Also the root of the social-card signing key (lib/og/sign.ts derives its own
# key from it with HKDF): rotating it changes every signed /api/og URL, which
# the pages pick up as they regenerate.
JWT_SECRET=replace-with-openssl-rand-base64-32

# ── Admin sign-in hardening ────────────────────────────────────────────────
# Passkeys, recovery codes, signed-in browsers and the "Require a passkey"
# policy live in data/auth.db and are managed in Admin → Security. Dangerous
# actions (restore, deletes, passkey and session changes) ask for a fresh
# check when the last sign-in or check is older than this many minutes
# (whole minutes, 1–60). Default 10.
# ADMIN_RECENT_AUTH_MINUTES=10

# ── Site URL (password-reset / email links, and the CSRF Origin allow-list
#    together with NEXT_PUBLIC_SITE_HOST; the request's own Host is always
#    accepted too) ──────────────────────────────────────────────────────────
SITE_URL=
NOTIFY_EMAIL=

# ── SMTP (optional)
#    lib/mailer.ts skips send if any of HOST / USER / PASS / FROM is unset
#    or blank, so dev can leave these empty and the contact form still
#    completes end-to-end (no mail leaves the box).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# Replies sent from Admin → Inbox go out FROM the SMTP account's own address
# (SMTP_USER, when it is an address) — the one your provider signs, so the
# recipient's DMARC check passes — with Reply-To set to the e-mail your site
# shows. Set REPLY_FROM_EMAIL only for another address your provider is
# allowed to sign for; the dashboard's test e-mail and the server log warn
# when a From domain's DMARC policy would reject the mail.
REPLY_FROM_EMAIL=

# ── Client IP for rate limits / login throttling ──────────────────────────
# Header that carries the real client address. Default `cf-connecting-ip`
# (Cloudflare / Cloudflare Tunnel overwrite it at their edge, so visitors
# can't forge it). Other values: `x-real-ip` (nginx), `x-forwarded-for`
# (read right-to-left, skipping trusted proxy hops), or `none` to use the
# TCP peer only (app exposed directly, no proxy). IPv6 clients are bucketed
# per /64 (login additionally per /48).
TRUST_CLIENT_IP_HEADER=cf-connecting-ip
# Which TCP peers may vouch for that header (comma-separated IPs and/or
# CIDRs). A request from any other peer is keyed by its own socket address,
# so something reaching the container directly can't claim a fresh client IP
# per request.
# Blank = loopback (127.0.0.0/8, ::1) plus the container's default gateway,
# read from /proc/net/route at startup (Linux; elsewhere loopback only).
# That is exactly where cloudflared on the host arrives from through Docker's
# 127.0.0.1:3002 → 3000 port mapping, so the standard deployment needs no
# value here. Note that every process on the host also connects from that
# gateway address: the host is inside the trust boundary. Set it explicitly
# when the proxy is elsewhere (another container, another machine) — e.g.
# 172.18.0.5 or 10.0.0.0/8.
TRUSTED_PROXY_IPS=

# ── Contact form human check (built-in, no external service) ──────────────
# Signed single-use nonce + math captcha + honeypot; no env required.
# Storage caps are built in: at most 300 messages are stored per UTC day
# (site-wide) and nothing more once data/contact-inbox.jsonl reaches 5 MB.
# Past a cap, messages are still emailed when SMTP (above) and NOTIFY_EMAIL
# or ADMIN_EMAIL are set; without email the form answers "try again later".

# ── GitHub API (raises unauthenticated 60/hr limit to 5000/hr) ───────────
# Use a fine-grained personal access token with "Public repositories
# (read-only)" access and NO repository or account permissions: the site only
# reads public profile, repo and event data. Never use a classic token with
# scopes. Without it, GitHub data shares the anonymous 60 requests/hour limit.
GITHUB_TOKEN=

# ── ORCID: "Connect your ORCID iD" in CV Studio (optional) ────────────────
# A free ORCID Public API client lets the owner prove which ORCID iD is
# theirs (OAuth sign-in, scope /authenticate — no access to the record), so
# the site shows it with ORCID's authenticated iD icon; without it a typed-in
# iD shows as "(unauthenticated)" and the button stays disabled. Register at
# https://orcid.org/developer-tools (Developer Tools → Register for ORCID
# Public API credentials) with the redirect URI
#   https://<your site>/api/admin/orcid/callback
# (SITE_URL's origin; e.g. https://lucian-dev.com/api/admin/orcid/callback).
# The secret stays on the server. ORCID_ENV=sandbox uses sandbox.orcid.org
# (a separate client registered at https://sandbox.orcid.org/developer-tools;
# ORCID accepts plain-http redirect URIs only there, for testing) to try it out.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# ORCID_ENV=production

# ── Database Management (MongoDB) ─────────────────────────────────────────
# Source of truth for /admin/db-config. When set, the admin UI loads these
# values read-only (so the connection string can't be edited from the GUI).
# Use the full Atlas SRV URL — credentials live INSIDE the URI.
MONGODB_URI=
MONGODB_DB_NAME=cv_database

# ── Cloudflare R2 (editorial content mirror) ──────────────────────────────
# Local SQLite at data/content.db is the canonical store; R2 is the off-site
# replica that survives container rebuilds. Every admin write dual-writes to
# both; on container startup `scripts/sync-from-r2.mjs` pulls R2 back into
# the local DB. Leave blank for offline dev — writes will only hit SQLite
# (and the API response will include a warning).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set to 1 in production so the container refuses to start if R2 is
# misconfigured (recommended for deployment, off for local dev).
R2_REQUIRED=0

# ── Logging ────────────────────────────────────────────────────────────────
# debug | info | warn | error. Default: info in production, debug otherwise.
# Production logs are one JSON object per line (docker logs).
# LOG_LEVEL=info

# ── Health detail for monitors (optional) ─────────────────────────────────
# /api/health tells everyone only {"status":"ok"|"empty"|"degraded"}. The
# detail (store and content state, R2 configuration, backup age, pending R2
# writes, warnings, uptime) goes to a signed-in admin and, when this is set,
# to requests sending `Authorization: Bearer <HEALTH_TOKEN>` (compared in
# constant time). Use a long random value, e.g. `openssl rand -hex 32`.
# Unset: no token grants the detail.
# HEALTH_TOKEN=

# ── Scheduled backups ──────────────────────────────────────────────────────
# Hours between automatic whole-site snapshots (skipped when nothing changed
# since the last one; pushed to R2 when configured). Default 24; 0 disables.
# BACKUP_INTERVAL_HOURS=24

# ── Restore drills ─────────────────────────────────────────────────────────
# Hours between automatic restore drills: the newest backup (R2
# backups/latest.tgz when configured, else the newest local snapshot) is
# opened in a scratch folder and checked — archive, checksums, SQLite
# integrity, migrations, row counts, an article render. The live site is
# never touched; results are in Admin → System and the /api/health detail.
# Default 168 (weekly); 0 disables.
# RESTORE_DRILL_INTERVAL_HOURS=168

# ── Content health: external link check ───────────────────────────────────
# Hours between the automatic checks of every external link on the published
# pages, the CV and the home page (Admin → System → Content). Polite: at most
# one request per site at a time, 2 s apart, HEAD first. 0 turns the schedule
# off ("Check links now" still works). Default 24.
# LINK_CHECK_INTERVAL_HOURS=24

# ── Contact-message retention ──────────────────────────────────────────────
# Days a contact-form message is kept in the admin Inbox. A nightly job
# (03:00 Hong Kong) deletes older ones, a restore never brings them back, and
# full-site snapshots older than this are pruned too (the newest is kept).
# The contact form's privacy notice states the period. Default 365; 0 keeps
# messages until you delete them (the notice then says so).
# CONTACT_RETENTION_DAYS=365

# ── Image encoding (uploads, imports, the media-optimize backfill) ─────────
# Images are encoded into their WebP / AVIF sizes one at a time across the
# server (lib/imageJobs), so concurrent uploads queue instead of running the
# 1 GiB container out of memory. IMAGE_JOB_CONCURRENCY: images encoded at
# once (1–4, default 1 — raise only with more CPUs and memory).
# IMAGE_JOB_QUEUE_MAX: uploads that may wait their turn (0–64, default 8);
# beyond that an upload answers 503 "busy, try again" at once.
# SHARP_CONCURRENCY: libvips threads per image (1–4, default the CPUs
# available, at most 2).
# IMAGE_JOB_CONCURRENCY=1
# IMAGE_JOB_QUEUE_MAX=8
# SHARP_CONCURRENCY=2

# ── Earlier builds' browser assets ────────────────────────────────────────
# Days the /_next/static files of previously deployed builds stay served
# after a deploy (the landing-static-archive volume; scripts/static-archive.mjs,
# run by docker-entrypoint.sh at boot), so HTML an edge cache or an open tab
# still holds can load its scripts. Whole days, 1–90. Default 7.
# STATIC_ARCHIVE_DAYS=7

# ── Cloudflare cache purge (optional) ──────────────────────────────────────
# When both are set, every on-demand revalidation also purges the refreshed
# URLs (plus feeds / sitemap / search index) from the Cloudflare cache. Unset:
# nothing is sent. The token needs Zone → Cache Purge → Purge for this zone.
# scripts/cloudflare-config.mjs reads the same pair, with a token that has
# Zone Settings:Edit, Config Rules:Edit, Cache Rules:Edit, Dynamic
# Redirect:Edit and DNS:Edit (optionally Account Analytics:Edit) — use a
# separate, short-lived token for that one-off run, not the runtime one.
# CF_ZONE_ID=
# CF_API_TOKEN=

# ── IndexNow (optional) ────────────────────────────────────────────────────
# 8–128 characters of [A-Za-z0-9-] (e.g. `openssl rand -hex 16`). When set,
# refreshed public URLs are submitted to https://api.indexnow.org and the key
# is served at the site root as /<INDEXNOW_KEY>.txt for verification (a key
# file only covers URLs in its own directory and below). Unset: IndexNow is
# off.
# INDEXNOW_KEY=
