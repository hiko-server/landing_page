NODE_ENV=production

# Admin auth (used to bootstrap admin.json if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change-this-strong-password

# JWT secret (required)
JWT_SECRET=super-secret-long-random-string

# Site URL (for emails/links)
SITE_URL=https://hiko.dev
NOTIFY_EMAIL=hi@hiko.dev

# SMTP (optional; if not set, emails are skipped)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
FROM_EMAIL=Hiko <no-reply@hiko.dev>

# Public branding
NEXT_PUBLIC_PRODUCT_NAME=HIKO.DEV

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_KEY=your-site-key
HCAPTCHA_SECRET=your-secret-key

# Optional: GitHub token for higher rate limit
GITHUB_TOKEN=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
ENABLE_DEMO=false
