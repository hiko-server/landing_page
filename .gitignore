#lh
.lh/
**.lh

# dependencies
/node_modules
/.pnp
.pnp.js

# Lockfile: project uses yarn.lock as source of truth (Dockerfile uses yarn).
# package-lock.json is a local convenience for npm install on Windows where yarn cache misbehaves.
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (NEVER commit secrets — .env.example holds documented placeholders)
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright (yarn e2e) output
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# CI audit report (scripts/check-audit.mjs --report)
/audit-report.json

# Server-local compose overrides: copy docker-compose.override.example.yml.
# Never tracked — it holds host-specific ports, mounts and networks.
docker-compose.override.yml
# Written by scripts/deploy.sh on the server.
.deployed-sha

# local data (persisted content, credentials)
data/

# Claude harness state (per-project session config)
.claude/

# Design preview (local-only working file)
.design-preview/

# Defence in depth — these contain credentials / hash and must NEVER be tracked,
# even if a future fork starts selectively tracking other things under data/.
data/admin.json
data/mongo_config.json
