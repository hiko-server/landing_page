{
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 2024,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "extends": [
        "next/core-web-vitals",
        "plugin:@typescript-eslint/recommended",
        "plugin:react/recommended"
    ],
    "plugins": [
        "@typescript-eslint",
        "react"
    ],
    "rules": {
        "react/react-in-jsx-scope": "off",
        "react/prop-types": "off",
        "@typescript-eslint/explicit-module-boundary-types": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "warn",
        "@typescript-eslint/no-var-requires": "warn",
        "no-console": "off",
        "no-empty": "warn",
        "no-empty-pattern": "warn",
        "no-extra-semi": "warn",
        "no-useless-escape": "warn",
        "no-unused-labels": "warn",
        "prefer-const": "warn",
        "no-var": "error",
        "react/jsx-key": "warn",
        "react/no-unescaped-entities": "warn",
        "react-hooks/rules-of-hooks": "warn",
        "react-hooks/exhaustive-deps": "warn",
        "@typescript-eslint/ban-ts-comment": "warn"
    },
    "overrides": [
        {
            "files": [
                "components/Header/**",
                "components/Footer/**",
                "components/Chrome/**",
                "pages/_app.tsx"
            ],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "framer-motion",
                                "importNames": ["motion"],
                                "message": "Use `m` from framer-motion: pages/_app wraps the app in <LazyMotion> (components/Chrome/MotionProvider.tsx) and loads the animation features on demand (lib/motionFeatures.ts). A `motion` element brings the whole library back into first-load JavaScript."
                            }
                        ],
                        "patterns": [
                            {
                                "group": ["react-icons/*"],
                                "message": "The persistent chrome ships in the shared bundle: use the inline icons in components/Icons/brand.tsx."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "components/General-UI/SectionHeading.tsx",
                "components/General-UI/PageHeader.tsx",
                "components/General-UI/PageGrid.tsx",
                "components/Article/MetaGrid.tsx",
                "components/GitHub/StatsBar.tsx",
                "components/Icons/**",
                "components/Header/ThemeControl.tsx",
                "components/Header/ThemeMenu.tsx",
                "components/BrandShowcase/BrandShowcase.tsx"
            ],
            "rules": {
                "no-restricted-syntax": [
                    "error",
                    {
                        "selector": "JSXAttribute[name.name=/^(fontSize|letterSpacing|lineHeight)$/] Literal[value=/^-?[0-9.]+(px|em|rem)$/]",
                        "message": "Design tokens: use a text style or token from theme/tokens.ts (textStyle=\"label\", fontSize=\"small\", letterSpacing=\"caps\") instead of a raw px / em value in a migrated component."
                    },
                    {
                        "selector": "Property[key.name=/^(fontSize|letterSpacing|lineHeight)$/] Literal[value=/^-?[0-9.]+(px|em|rem)$/]",
                        "message": "Design tokens: use a text style or token from theme/tokens.ts (textStyle=\"label\", fontSize=\"small\", letterSpacing=\"caps\") instead of a raw px / em value in a migrated component."
                    },
                    {
                        "selector": "Literal[value=/cubic-bezier\\(/]",
                        "message": "Design tokens: use the standard ease (var(--ease-standard), EASE_STANDARD_CSS, cssTransition(), motionTransition()) from theme/tokens.ts instead of a cubic-bezier literal."
                    },
                    {
                        "selector": "TemplateElement[value.raw=/cubic-bezier\\(/]",
                        "message": "Design tokens: use the standard ease (var(--ease-standard), EASE_STANDARD_CSS, cssTransition(), motionTransition()) from theme/tokens.ts instead of a cubic-bezier literal."
                    },
                    {
                        "selector": "Property[key.name='ease'] > ArrayExpression",
                        "message": "Design tokens: use motionTransition() from theme/tokens.ts instead of an inline framer-motion ease array."
                    }
                ]
            }
        },
        {
            "files": [
                "components/**",
                "pages/**",
                "layout/**"
            ],
            "excludedFiles": [
                "components/Admin/**",
                "pages/admin/**"
            ],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "framer-motion",
                                "importNames": ["motion"],
                                "message": "Use `m` from framer-motion: pages/_app wraps the app in <LazyMotion> (components/Chrome/MotionProvider.tsx) and loads the animation features on demand (lib/motionFeatures.ts). A `motion` element brings the whole library back into first-load JavaScript."
                            }
                        ],
                        "patterns": [
                            {
                                "group": ["react-icons", "react-icons/*", "@chakra-ui/icons"],
                                "message": "Public pages use one icon set: the Lucide icons in components/Icons/ui (chrome / theme / content) and the brand marks in components/Icons/brand.tsx. react-icons stays in the admin."
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "settings": {
        "react": {
            "version": "detect"
        }
    },
    "env": {
        "browser": true,
        "es2024": true,
        "node": true
    },
    "ignorePatterns": [
        "node_modules",
        ".next",
        "out",
        "build",
        "dist"
    ]
}